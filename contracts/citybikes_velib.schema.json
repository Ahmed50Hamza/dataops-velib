{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/citybikes-velib.schema.json",
  "title": "CityBikes network station snapshot",
  "type": "object",
  "required": ["network"],
  "properties": {
    "network": {
      "type": "object",
      "required": ["id", "stations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "latitude",
              "longitude",
              "free_bikes",
              "empty_slots"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
              "free_bikes": { "type": "integer", "minimum": 0 },
              "empty_slots": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
